# Copy to .env and fill in. .env is gitignored.
GEMINI_API_KEY=your-key-here

# Optional. Pins the model instead of probing candidates at startup.
# GEMINI_MODEL=gemini-flash-lite-latest

# --- Tuning (all optional; defaults in pantry/config.py) ---
# PANTRY_WAKE_THRESHOLD=0.6      # higher = fewer false fires
# PANTRY_VAD_SILENCE_MS=700      # lower = snappier, more likely to clip you
# PANTRY_VAD_START_MS=160
# PANTRY_UTTERANCE_TIMEOUT_S=6   # give up if no speech after the wake word
# PANTRY_FOLLOWUP_TIMEOUT_S=8    # keep listening this long after a reply
# PANTRY_MIC_MATCH=USB
